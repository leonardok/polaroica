{
  "name": "vsphoto",
  "displayName": "Photo Library",
  "description": "Browse and organize photo libraries — local folders and SMB network shares — inside VS Code.",
  "version": "0.8.3",
  "publisher": "leonardok",
  "license": "GPL-3.0-or-later",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#11143a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leonardok/vsphoto"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "photo",
    "image",
    "library",
    "gallery",
    "smb",
    "nas"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsphoto",
          "title": "Photo Library",
          "icon": "media/library.svg"
        }
      ]
    },
    "views": {
      "vsphoto": [
        {
          "id": "vsphoto.libraries",
          "name": "Photo Libraries",
          "icon": "media/library.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vsphoto.libraries",
        "contents": "No photo libraries yet. A library is a local folder or an SMB share your computer can already reach.\n[Add Library](command:vsphoto.addLibrary)",
        "when": "workbenchState == empty || workspaceFolderCount == 0"
      }
    ],
    "commands": [
      {
        "command": "vsphoto.addLibrary",
        "title": "Add Library…",
        "category": "Photo Library",
        "icon": "$(add)"
      },
      {
        "command": "vsphoto.refresh",
        "title": "Refresh",
        "category": "Photo Library",
        "icon": "$(refresh)"
      },
      {
        "command": "vsphoto.removeLibrary",
        "title": "Remove Library",
        "category": "Photo Library",
        "icon": "$(close)"
      },
      {
        "command": "vsphoto.openFolder",
        "title": "Open Photos",
        "category": "Photo Library",
        "icon": "$(file-media)"
      },
      {
        "command": "vsphoto.moveTo",
        "title": "Move to…",
        "category": "Photo Library",
        "icon": "$(move)"
      },
      {
        "command": "vsphoto.newFolder",
        "title": "New Folder…",
        "category": "Photo Library",
        "icon": "$(new-folder)"
      },
      {
        "command": "vsphoto.revealInOS",
        "title": "Reveal in OS",
        "category": "Photo Library",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vsphoto.cacheInfo",
        "title": "Show Cache Info",
        "category": "Photo Library",
        "icon": "$(info)"
      },
      {
        "command": "vsphoto.buildThumbnails",
        "title": "Build All Thumbnails",
        "category": "Photo Library",
        "icon": "$(run-all)"
      },
      {
        "command": "vsphoto.thumbnailProgress",
        "title": "Thumbnail Progress…",
        "category": "Photo Library",
        "icon": "$(pulse)"
      },
      {
        "command": "vsphoto.photoMoveTo",
        "title": "Move to…",
        "category": "Photo Library",
        "icon": "$(move)"
      },
      {
        "command": "vsphoto.photoReveal",
        "title": "Reveal in OS",
        "category": "Photo Library",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vsphoto.photoExport",
        "title": "Export to JPEG…",
        "category": "Photo Library",
        "icon": "$(export)"
      },
      {
        "command": "vsphoto.autoRank",
        "title": "Auto-Rank Album…",
        "category": "Photo Library",
        "icon": "$(sparkle)"
      },
      {
        "command": "vsphoto.undoAutoRank",
        "title": "Undo Auto-Rank",
        "category": "Photo Library",
        "icon": "$(discard)",
        "enablement": "vsphoto.canUndoAutoRank"
      },
      {
        "command": "vsphoto.exportPhotos",
        "title": "Export to JPEG…",
        "category": "Photo Library",
        "icon": "$(export)"
      },
      {
        "command": "vsphoto.deleteRejected",
        "title": "Delete Rejected Photos…",
        "category": "Photo Library",
        "icon": "$(trash)"
      },
      {
        "command": "vsphoto.showLog",
        "title": "Show Log",
        "category": "Photo Library",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vsphoto.addLibrary",
          "when": "view == vsphoto.libraries",
          "group": "navigation@1"
        },
        {
          "command": "vsphoto.refresh",
          "when": "view == vsphoto.libraries",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "vsphoto.openFolder",
          "when": "view == vsphoto.libraries && viewItem =~ /^(library|folder)$/",
          "group": "1_open@1"
        },
        {
          "command": "vsphoto.autoRank",
          "when": "view == vsphoto.libraries && viewItem =~ /^(library|folder)$/",
          "group": "1_open@2"
        },
        {
          "command": "vsphoto.undoAutoRank",
          "when": "view == vsphoto.libraries && viewItem =~ /^(library|folder)$/ && vsphoto.canUndoAutoRank",
          "group": "1_open@3"
        },
        {
          "command": "vsphoto.newFolder",
          "when": "view == vsphoto.libraries && viewItem =~ /^(library|folder)$/",
          "group": "2_edit@1"
        },
        {
          "command": "vsphoto.moveTo",
          "when": "view == vsphoto.libraries && viewItem == folder",
          "group": "2_edit@2"
        },
        {
          "command": "vsphoto.exportPhotos",
          "when": "view == vsphoto.libraries && viewItem =~ /^(library|folder)$/",
          "group": "2_edit@3"
        },
        {
          "command": "vsphoto.deleteRejected",
          "when": "view == vsphoto.libraries && viewItem =~ /^(library|folder)$/",
          "group": "2_edit@4"
        },
        {
          "command": "vsphoto.revealInOS",
          "when": "view == vsphoto.libraries && viewItem =~ /^(library|folder)$/",
          "group": "3_reveal@1"
        },
        {
          "command": "vsphoto.removeLibrary",
          "when": "view == vsphoto.libraries && viewItem =~ /^library/",
          "group": "9_library@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vsphoto.removeLibrary",
          "when": "false"
        },
        {
          "command": "vsphoto.openFolder",
          "when": "false"
        },
        {
          "command": "vsphoto.moveTo",
          "when": "false"
        },
        {
          "command": "vsphoto.newFolder",
          "when": "false"
        },
        {
          "command": "vsphoto.revealInOS",
          "when": "false"
        },
        {
          "command": "vsphoto.photoMoveTo",
          "when": "false"
        },
        {
          "command": "vsphoto.photoReveal",
          "when": "false"
        },
        {
          "command": "vsphoto.photoExport",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "vsphoto.photoMoveTo",
          "when": "(webviewId == 'vsphoto.grid' || webviewId == 'vsphoto.photo') && webviewSection == 'photo'",
          "group": "1_photo@1"
        },
        {
          "command": "vsphoto.photoReveal",
          "when": "(webviewId == 'vsphoto.grid' || webviewId == 'vsphoto.photo') && webviewSection == 'photo'",
          "group": "1_photo@3"
        },
        {
          "command": "vsphoto.photoExport",
          "when": "(webviewId == 'vsphoto.grid' || webviewId == 'vsphoto.photo') && webviewSection == 'photo'",
          "group": "1_photo@2"
        }
      ]
    },
    "configuration": {
      "title": "Photo Library",
      "properties": {
        "vsphoto.sortBy": {
          "type": "string",
          "enum": [
            "name",
            "modified",
            "size"
          ],
          "enumDescriptions": [
            "File name (natural order: IMG_2 before IMG_10)",
            "Date modified",
            "File size"
          ],
          "default": "name",
          "description": "Default order of photos in the grid and in photo tabs."
        },
        "vsphoto.showPhotoCounts": {
          "type": "boolean",
          "default": true,
          "description": "Show how many photos each folder holds in the Photo Libraries tree. Turn off for very slow shares."
        },
        "vsphoto.thumbnailSize": {
          "type": "number",
          "enum": [
            192,
            256,
            320
          ],
          "default": 256,
          "description": "Long edge of generated thumbnails in pixels. Bigger looks sharper at large grid sizes but uses more disk (about 4, 6 and 9 KB per photo). Changing it regenerates thumbnails."
        },
        "vsphoto.cacheSizeMB": {
          "type": "number",
          "default": 1024,
          "minimum": 50,
          "description": "Most disk space the local thumbnail cache may use, in MB. Least recently viewed folders are removed first. About 5 KB per photo at the default thumbnail size, so 1024 MB holds roughly 200,000 photos."
        },
        "vsphoto.backgroundThumbnails": {
          "type": "boolean",
          "default": true,
          "description": "Build thumbnails for every photo in your libraries in the background: a quick pass from each photo's small EXIF preview, then sharp thumbnails from the camera's built-in preview (or the full file). Reads the share gently and waits while you browse."
        },
        "vsphoto.autoRank.burstSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 0.2,
          "maximum": 30,
          "description": "Auto-Rank: photos taken at most this many seconds apart that look alike are one burst of similar shots."
        },
        "vsphoto.autoRank.sceneSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 600,
          "description": "Auto-Rank: photos taken up to this many seconds apart also stack together when they show the same scene and framing (same colours in the same places) — the same pose shot again after a short pause. 0 turns this off."
        },
        "vsphoto.export.quality": {
          "type": "number",
          "default": 90,
          "minimum": 50,
          "maximum": 100,
          "description": "JPEG quality of exported photos (50–100). 90 keeps all visible detail; 95+ mostly makes files bigger."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "tsc -p ./ && node --test out/test/*.test.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/webp": "1.5.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "libraw-wasm": "1.6.0"
  }
}
