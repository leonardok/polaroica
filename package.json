{
  "name": "polaroica",
  "displayName": "Polaroica",
  "description": "Browse and organize photo libraries — local folders and SMB network shares — inside VS Code.",
  "version": "0.10.8",
  "publisher": "ChimarraoTech",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1c1917",
    "theme": "dark"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/leonardok/polaroica"
  },
  "homepage": "https://leok.me/polaroica",
  "bugs": {
    "url": "https://github.com/leonardok/polaroica/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "photo",
    "image",
    "library",
    "gallery",
    "smb",
    "nas"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "polaroica",
          "title": "Polaroica",
          "icon": "media/library.svg"
        }
      ]
    },
    "views": {
      "polaroica": [
        {
          "id": "polaroica.libraries",
          "name": "Libraries",
          "icon": "media/library.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "polaroica.libraries",
        "contents": "No photo libraries yet. A library is a local folder or an SMB share your computer can already reach.\n[Add Library](command:polaroica.addLibrary)",
        "when": "workbenchState == empty || workspaceFolderCount == 0"
      }
    ],
    "commands": [
      {
        "command": "polaroica.addLibrary",
        "title": "Add Library…",
        "category": "Polaroica",
        "icon": "$(add)"
      },
      {
        "command": "polaroica.refresh",
        "title": "Refresh",
        "category": "Polaroica",
        "icon": "$(refresh)"
      },
      {
        "command": "polaroica.removeLibrary",
        "title": "Remove Library",
        "category": "Polaroica",
        "icon": "$(close)"
      },
      {
        "command": "polaroica.openFolder",
        "title": "Open Photos",
        "category": "Polaroica",
        "icon": "$(file-media)"
      },
      {
        "command": "polaroica.moveTo",
        "title": "Move to…",
        "category": "Polaroica",
        "icon": "$(move)"
      },
      {
        "command": "polaroica.newFolder",
        "title": "New Folder…",
        "category": "Polaroica",
        "icon": "$(new-folder)"
      },
      {
        "command": "polaroica.revealInOS",
        "title": "Reveal in OS",
        "category": "Polaroica",
        "icon": "$(folder-opened)"
      },
      {
        "command": "polaroica.cacheInfo",
        "title": "Show Cache Info",
        "category": "Polaroica",
        "icon": "$(info)"
      },
      {
        "command": "polaroica.buildThumbnails",
        "title": "Build All Thumbnails",
        "category": "Polaroica",
        "icon": "$(run-all)"
      },
      {
        "command": "polaroica.buildThumbnailsHere",
        "title": "Build Thumbnails Here…",
        "category": "Polaroica",
        "icon": "$(file-media)"
      },
      {
        "command": "polaroica.thumbnailProgress",
        "title": "Thumbnail Progress…",
        "category": "Polaroica",
        "icon": "$(pulse)"
      },
      {
        "command": "polaroica.photoMoveTo",
        "title": "Move to…",
        "category": "Polaroica",
        "icon": "$(move)"
      },
      {
        "command": "polaroica.photoReveal",
        "title": "Reveal in OS",
        "category": "Polaroica",
        "icon": "$(folder-opened)"
      },
      {
        "command": "polaroica.photoExport",
        "title": "Export to JPEG…",
        "category": "Polaroica",
        "icon": "$(export)"
      },
      {
        "command": "polaroica.autoRank",
        "title": "Auto-Rank Album…",
        "category": "Polaroica",
        "icon": "$(sparkle)"
      },
      {
        "command": "polaroica.undoAutoRank",
        "title": "Undo Auto-Rank",
        "category": "Polaroica",
        "icon": "$(discard)",
        "enablement": "polaroica.canUndoAutoRank"
      },
      {
        "command": "polaroica.exportPhotos",
        "title": "Export to JPEG…",
        "category": "Polaroica",
        "icon": "$(export)"
      },
      {
        "command": "polaroica.deleteRejected",
        "title": "Delete Rejected Photos…",
        "category": "Polaroica",
        "icon": "$(trash)"
      },
      {
        "command": "polaroica.showLog",
        "title": "Show Log",
        "category": "Polaroica",
        "icon": "$(output)"
      },
      {
        "command": "polaroica.copyPath",
        "title": "Copy Path",
        "category": "Polaroica",
        "icon": "$(clippy)"
      },
      {
        "command": "polaroica.photoCopyPath",
        "title": "Copy Path",
        "category": "Polaroica",
        "icon": "$(clippy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "polaroica.addLibrary",
          "when": "view == polaroica.libraries",
          "group": "navigation@1"
        },
        {
          "command": "polaroica.refresh",
          "when": "view == polaroica.libraries",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "polaroica.openFolder",
          "when": "view == polaroica.libraries && viewItem =~ /^(library|folder)$/",
          "group": "1_open@1"
        },
        {
          "command": "polaroica.autoRank",
          "when": "view == polaroica.libraries && viewItem =~ /^(library|folder)$/",
          "group": "1_open@2"
        },
        {
          "command": "polaroica.undoAutoRank",
          "when": "view == polaroica.libraries && viewItem =~ /^(library|folder)$/ && polaroica.canUndoAutoRank",
          "group": "1_open@3"
        },
        {
          "command": "polaroica.newFolder",
          "when": "view == polaroica.libraries && viewItem =~ /^(library|folder)$/",
          "group": "2_edit@1"
        },
        {
          "command": "polaroica.moveTo",
          "when": "view == polaroica.libraries && viewItem == folder",
          "group": "2_edit@2"
        },
        {
          "command": "polaroica.exportPhotos",
          "when": "view == polaroica.libraries && viewItem =~ /^(library|folder)$/",
          "group": "2_edit@3"
        },
        {
          "command": "polaroica.deleteRejected",
          "when": "view == polaroica.libraries && viewItem =~ /^(library|folder)$/",
          "group": "2_edit@4"
        },
        {
          "command": "polaroica.revealInOS",
          "when": "view == polaroica.libraries && viewItem =~ /^(library|folder)$/",
          "group": "3_reveal@1"
        },
        {
          "command": "polaroica.buildThumbnailsHere",
          "when": "view == polaroica.libraries && viewItem =~ /^(library|folder)$/",
          "group": "4_thumbs@1"
        },
        {
          "command": "polaroica.removeLibrary",
          "when": "view == polaroica.libraries && viewItem =~ /^library/",
          "group": "9_library@1"
        },
        {
          "submenu": "polaroica.copy",
          "when": "view == polaroica.libraries && viewItem =~ /^(library|folder)$/",
          "group": "3_reveal@2"
        }
      ],
      "commandPalette": [
        {
          "command": "polaroica.removeLibrary",
          "when": "false"
        },
        {
          "command": "polaroica.openFolder",
          "when": "false"
        },
        {
          "command": "polaroica.moveTo",
          "when": "false"
        },
        {
          "command": "polaroica.newFolder",
          "when": "false"
        },
        {
          "command": "polaroica.revealInOS",
          "when": "false"
        },
        {
          "command": "polaroica.photoMoveTo",
          "when": "false"
        },
        {
          "command": "polaroica.photoReveal",
          "when": "false"
        },
        {
          "command": "polaroica.photoExport",
          "when": "false"
        },
        {
          "command": "polaroica.copyPath",
          "when": "false"
        },
        {
          "command": "polaroica.photoCopyPath",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "polaroica.photoMoveTo",
          "when": "(webviewId == 'polaroica.grid' || webviewId == 'polaroica.photo') && webviewSection == 'photo'",
          "group": "1_photo@1"
        },
        {
          "command": "polaroica.photoReveal",
          "when": "(webviewId == 'polaroica.grid' || webviewId == 'polaroica.photo') && webviewSection == 'photo'",
          "group": "1_photo@3"
        },
        {
          "command": "polaroica.photoExport",
          "when": "(webviewId == 'polaroica.grid' || webviewId == 'polaroica.photo') && webviewSection == 'photo'",
          "group": "1_photo@2"
        },
        {
          "submenu": "polaroica.copy",
          "when": "(webviewId == 'polaroica.grid' || webviewId == 'polaroica.photo') && webviewSection == 'photo'",
          "group": "1_photo@4"
        }
      ],
      "polaroica.copy": [
        {
          "command": "polaroica.copyPath",
          "when": "view == polaroica.libraries",
          "group": "1_path@1"
        },
        {
          "command": "polaroica.photoCopyPath",
          "when": "webviewId == 'polaroica.grid' || webviewId == 'polaroica.photo'",
          "group": "1_path@1"
        }
      ]
    },
    "configuration": {
      "title": "Polaroica",
      "properties": {
        "polaroica.sortBy": {
          "type": "string",
          "enum": [
            "name",
            "modified",
            "size"
          ],
          "enumDescriptions": [
            "File name (natural order: IMG_2 before IMG_10)",
            "Date modified",
            "File size"
          ],
          "default": "name",
          "description": "Default order of photos in the grid and in photo tabs."
        },
        "polaroica.showPhotoCounts": {
          "type": "boolean",
          "default": true,
          "description": "Show how many photos each folder holds in the Libraries tree. Turn off for very slow shares."
        },
        "polaroica.thumbnailSize": {
          "type": "number",
          "enum": [
            192,
            256,
            320
          ],
          "default": 256,
          "description": "Long edge of generated thumbnails in pixels. Bigger looks sharper at large grid sizes but uses more disk (about 4, 6 and 9 KB per photo). Changing it regenerates thumbnails."
        },
        "polaroica.cacheSizeMB": {
          "type": "number",
          "default": 1024,
          "minimum": 50,
          "description": "Most disk space the local thumbnail cache may use, in MB. Least recently viewed folders are removed first. About 5 KB per photo at the default thumbnail size, so 1024 MB holds roughly 200,000 photos."
        },
        "polaroica.backgroundThumbnails": {
          "type": "boolean",
          "default": false,
          "description": "Build thumbnails for every photo in every library in the background, starting when the window opens: a quick pass from each photo's small EXIF preview, then sharp thumbnails from the camera's built-in preview (or the full file). Off by default: thumbnails are built as you open albums, and Build Thumbnails Here (right-click an album) builds ahead of time. For a very large library, raise Cache Size MB before turning this on."
        },
        "polaroica.autoRank.burstSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 0.2,
          "maximum": 30,
          "description": "Auto-Rank: photos taken at most this many seconds apart that look alike are one burst of similar shots."
        },
        "polaroica.autoRank.sceneSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 600,
          "description": "Auto-Rank: photos taken up to this many seconds apart also stack together when they show the same scene and framing (same colours in the same places) — the same pose shot again after a short pause. 0 turns this off."
        },
        "polaroica.autoAdjust.exposure": {
          "type": "number",
          "default": 0,
          "minimum": -2,
          "maximum": 2,
          "markdownDescription": "Auto adjust: added to the Exposure Auto sets, in EV (e.g. `0.3` for photos a little brighter than Auto makes them)."
        },
        "polaroica.autoAdjust.contrast": {
          "type": "number",
          "default": 0,
          "minimum": -100,
          "maximum": 100,
          "markdownDescription": "Auto adjust: added to the Contrast Auto sets (−100 to 100)."
        },
        "polaroica.autoAdjust.highlights": {
          "type": "number",
          "default": 0,
          "minimum": -100,
          "maximum": 100,
          "markdownDescription": "Auto adjust: added to the Highlights Auto sets (−100 to 100)."
        },
        "polaroica.autoAdjust.shadows": {
          "type": "number",
          "default": 0,
          "minimum": -100,
          "maximum": 100,
          "markdownDescription": "Auto adjust: added to the Shadows Auto sets (−100 to 100)."
        },
        "polaroica.autoAdjust.whites": {
          "type": "number",
          "default": 0,
          "minimum": -100,
          "maximum": 100,
          "markdownDescription": "Auto adjust: added to the Whites Auto sets (−100 to 100)."
        },
        "polaroica.autoAdjust.blacks": {
          "type": "number",
          "default": 0,
          "minimum": -100,
          "maximum": 100,
          "markdownDescription": "Auto adjust: added to the Blacks Auto sets (−100 to 100)."
        },
        "polaroica.autoAdjust.temperature": {
          "type": "number",
          "default": 0,
          "minimum": -100,
          "maximum": 100,
          "markdownDescription": "Auto adjust: added to the Temp Auto sets (−100 to 100). Positive is warmer (e.g. `10`), negative cooler."
        },
        "polaroica.autoAdjust.tint": {
          "type": "number",
          "default": 0,
          "minimum": -100,
          "maximum": 100,
          "markdownDescription": "Auto adjust: added to the Tint Auto sets. Positive is more magenta, negative more green."
        },
        "polaroica.autoAdjust.vibrance": {
          "type": "number",
          "default": 0,
          "minimum": -100,
          "maximum": 100,
          "markdownDescription": "Auto adjust: added to the Vibrance Auto sets (−100 to 100)."
        },
        "polaroica.autoAdjust.saturation": {
          "type": "number",
          "default": 0,
          "minimum": -100,
          "maximum": 100,
          "markdownDescription": "Auto adjust: added to the Saturation Auto sets (−100 to 100)."
        },
        "polaroica.export.quality": {
          "type": "number",
          "default": 90,
          "minimum": 50,
          "maximum": 100,
          "description": "JPEG quality of exported photos (50–100). 90 keeps all visible detail; 95+ mostly makes files bigger."
        }
      }
    },
    "submenus": [
      {
        "id": "polaroica.copy",
        "label": "Copy"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "tsc -p ./ && node --test out/test/*.test.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/webp": "1.5.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "libraw-wasm": "1.6.0"
  }
}
